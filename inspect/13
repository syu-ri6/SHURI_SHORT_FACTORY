<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>SHURI SHORT FACTORY</title>
  <style>
    :root{
      --bg:#0b0d12;--panel:#151a24;--line:#2d3445;--muted:#93a0b5;--text:#fff;
      --pink:#ff4da6;--violet:#8c78ff;--yellow:#ffd34e;--cyan:#41d4ff;--green:#66e6a4;
    }
    *{box-sizing:border-box}
    body{margin:0;background:linear-gradient(180deg,#171b2a,#0b0d12 36%);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans","Yu Gothic",sans-serif}
    .app{max-width:1180px;margin:auto;padding:18px 14px 60px}
    .top{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px}
    .brand{display:flex;gap:10px;align-items:center}
    .logo{width:42px;height:42px;border-radius:14px;background:linear-gradient(135deg,var(--pink),var(--violet));display:grid;place-items:center;font-size:22px}
    h1{font-size:18px;margin:0}.sub{font-size:11px;color:var(--muted)}
    .badge{font-size:11px;border:1px solid var(--line);border-radius:999px;padding:6px 9px;background:rgba(255,255,255,.03)}
    .grid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(320px,.8fr);gap:14px}
    @media(max-width:920px){.grid{grid-template-columns:1fr}}
    .card{background:rgba(20,25,35,.96);border:1px solid var(--line);border-radius:18px;overflow:hidden}
    .head{padding:12px 14px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;font-size:13px;gap:8px}
    .body{padding:14px}
    .stage{position:relative;width:min(100%,420px);aspect-ratio:9/16;margin:auto;background:#050608;border:1px solid #343a4a;border-radius:18px;overflow:hidden}
    .stage video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;background:#050608}
    .base-overlay{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;pointer-events:none;opacity:1;z-index:1}.command-overlay{position:absolute;bottom:1.6%;width:24.5%;height:auto;pointer-events:none;z-index:2;display:none;transform:scale(1.06);transform-origin:center bottom;filter:brightness(1.13) drop-shadow(0 0 9px rgba(255,77,166,.55))}.command-overlay.show{display:block}
    .empty{position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:32px;color:var(--muted);font-size:13px;background:linear-gradient(180deg,rgba(5,6,8,.62),rgba(5,6,8,.8));z-index:4}
    .dynamic{position:absolute;inset:0;pointer-events:none;z-index:3}
    .safe{position:absolute;inset:5%;border:1px dashed rgba(255,255,255,.18);border-radius:12px}
    .ov{position:absolute;display:none;max-width:76%;padding:8px 10px;border-radius:11px;background:rgba(9,12,18,.95);border:1px solid #fff;font-size:12px;line-height:1.4;box-shadow:0 8px 28px rgba(0,0,0,.35)}
    .ov.show{display:block}.ov:before{display:block;font-size:9px;font-weight:900;letter-spacing:.12em;margin-bottom:4px}
    .system:before{content:'SYSTEM';color:#9fb3ff}.warning{border-color:var(--yellow)}.warning:before{content:'⚠ WARNING';color:var(--yellow)}.mission{border-color:#b09cff}.mission:before{content:'MISSION';color:#cabfff}
    .mini{display:flex;align-items:center;gap:8px;padding:8px 10px;border-radius:10px;border:1px solid var(--line);background:#10151d;font-size:12px}
    .ok{color:var(--green)} .warn{color:var(--yellow)} .muted{color:var(--muted)}
    .controls,.pills{display:flex;gap:7px;flex-wrap:wrap}.btn,.pill,.snap{border:1px solid var(--line);background:#151b26;color:#fff;border-radius:10px;padding:8px 10px;font-size:12px}
    .btn.primary{background:linear-gradient(135deg,var(--pink),#ff7dbb);border:none}.pill{border-radius:999px;font-size:11px}.pill.active{background:#382f5c;border-color:#7664cf}
    .range{width:100%;accent-color:var(--pink);margin-top:10px}.section{margin-bottom:15px}.title{font-size:12px;font-weight:900;margin-bottom:8px;display:flex;justify-content:space-between;gap:8px}.title span{font-size:10px;color:var(--muted);font-weight:600}
    .legend{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}.legend div{padding:8px;border:1px solid var(--line);border-radius:10px;text-align:center;font-size:10px}
    .field{width:100%;background:#0d121a;border:1px solid var(--line);color:#fff;border-radius:10px;padding:9px 10px;font-size:12px}
    .row{display:grid;grid-template-columns:1fr 1fr;gap:8px}.nine{display:grid;grid-template-columns:repeat(3,1fr);gap:5px}.snap{aspect-ratio:1.65;padding:0;color:#aeb7c7;font-size:10px}.snap.active{background:#3a315f;color:#fff;border-color:#7664cf}
    .timeline{height:82px;border:1px solid var(--line);background:#0c1117;border-radius:12px;position:relative;overflow:hidden}
    .ticks{position:absolute;inset:0;background:repeating-linear-gradient(90deg,transparent 0 calc(10% - 1px),rgba(255,255,255,.05) calc(10% - 1px) 10%)}
    .playhead{position:absolute;top:0;bottom:0;width:2px;background:var(--pink)}
    .ev{position:absolute;height:18px;border-radius:5px;top:10px;background:#4d5676;font-size:8px;padding:3px 5px;white-space:nowrap;overflow:hidden}
    .ev.hp{top:34px;background:#7f4859}.ev.base{top:56px;background:#3d6c5e}
    .layer{border:1px solid var(--line);border-radius:12px;padding:9px;background:#0f141d;margin-bottom:8px}.layer b{font-size:10px}.meta{font-size:9px;color:var(--muted);margin-top:4px}
    .stats{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.stat{border:1px solid var(--line);border-radius:11px;padding:9px;background:#0f141d}.stat b{display:block;font-size:18px}.stat span{font-size:9px;color:var(--muted)}
    .log{height:200px;overflow:auto;background:#080b10;border:1px solid var(--line);border-radius:10px;padding:9px;font:10px/1.55 ui-monospace,monospace;color:#ced7e7;white-space:pre-wrap}
    .note{font-size:10px;color:var(--muted);line-height:1.55}
    .chip{display:inline-block;font-size:10px;border:1px solid var(--line);padding:2px 7px;border-radius:999px;color:#dbe4f4;background:#0f141d}
    input[type=file]{display:none}
  </style>
</head>
<body>
<div class="app">
  <div class="top">
    <div class="brand">
      <div class="logo">🏭</div>
      <div>
        <h1>SHURI SHORT FACTORY</h1>
        <div class="sub">作業は機械へ。面白さはしゅりへ。</div>
      </div>
    </div>
    <div class="badge">BASE＋COMMAND版</div>
  </div>

  <div class="grid">
    <div>
      <div class="card">
        <div class="head"><b>🎬 PREVIEW</b><span id="clock">00:00.00 / 00:00.00</span></div>
        <div class="body">
          <div class="stage">
            <video id="video" playsinline></video>
            <img id="baseOverlay" class="base-overlay" src="assets/sm-base-normal.webp" alt="BASE overlay">
            <img id="commandOverlay" class="command-overlay" alt="selected command">
            <div class="dynamic">
              <div class="safe"></div>
              <div class="ov system" id="systemBox">ここに状況・ナレーション・冷静ツッコミ</div>
              <div class="ov warning" id="warningBox">危険生物の可能性</div>
              <div class="ov mission" id="missionBox">対象の正体を確認せよ</div>
            </div>
            <div class="empty" id="empty">動画を読み込む<br>本物のBASEを動画の上に重ねています。</div>
          </div>
          <input id="fileInput" type="file" accept="video/mp4,video/quicktime,video/x-m4v,video/*">
          <div class="controls" style="margin-top:12px">
            <label class="btn primary" for="fileInput">＋ 動画を読み購み</label>
            <button class="btn" id="playBtn">■ 再生</button>
            <button class="btn" id="markStartBtn">こせからの</button>
            <button class="btn" id="markEndBtn">ここまで</button>
          </div>
          <div class="mini" style="margin-top:10px"><span class="ok">✅</span><span id="loadStatus">BASE{COMMAND{*已退み　／ 動画㾅機中</span></div>
          <input id="scrub" class="range" type="range" min="0" max="1000" value="0">
          <div class="title" style="margin-top:10px">TIMELINE <span>区間で置く</span></div>
          <div class="timeline" id="timeline"><div class="ticks"></div><div class="playhead" id="playhead"></div></div>
        </div>
      </div>

      <div class="card" style="margin-top:14px">
        <div class="head"><b>🧪 PRODUCTION LOG</b><buttn class="btn" id="exportBtn">ログを書き出す</button></div>
        <div class="body">
          <div class="stats">
            <div class="stat"><b id="eventCount">0</b><span>追加した演出</span></div>
            <div class="stat"><b id="decisionCount">0</b><span>手�5判断</span></div>
            <div class="stat"><b id="autoCount">0</b><span>AUTO採用</span></div>
            <div class="stat"><b id="elapsed">00:00</b><span>作成時間</span></div>
          </div>
          <div class="log" id="log" style="margin-top:10px">SHURI S